# Contact form while developing (npm start). The site key is Cloudflare's Turnstile test key that
# always passes, and the endpoint is workers/contact running on this machine:
#   node workers/contact/dev-server.js
# See workers/contact/README.md
REACT_APP_TURNSTILE_SITE_KEY=1x00000000000000000000AA
REACT_APP_CONTACT_ENDPOINT=http://localhost:8787/
