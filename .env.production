# Contact form in the published site (npm run deploy). It shows up only when both are set; until
# then the contact dialog shows the e-mail and LinkedIn. See workers/contact/README.md
#   Site key: Cloudflare dashboard > Turnstile > the widget for take-me.jp (it's public)
#   Endpoint: the URL of workers/contact once deployed
REACT_APP_TURNSTILE_SITE_KEY=
REACT_APP_CONTACT_ENDPOINT=
