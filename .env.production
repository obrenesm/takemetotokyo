# Contact form in the published site. It shows up only when both are set; until then the contact
# dialog shows the e-mail and LinkedIn. See workers/contact/README.md
#   Site key: the Turnstile widget for take-me.jp (public, it ends up in the page anyway)
#   Endpoint: the URL of workers/contact once deployed. Values set in Vercel's Environment
#   Variables (Production) take precedence over this file
REACT_APP_TURNSTILE_SITE_KEY=0x4AAAAAAF9BIeEJtpLNzk9b
REACT_APP_CONTACT_ENDPOINT=https://take-me-contact.takemejp.workers.dev/
